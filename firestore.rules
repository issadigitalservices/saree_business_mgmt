rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =================================
       USER ACCESS HELPERS
    ================================= */

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveUser() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && userProfile().active == true;
    }

    function isAdmin() {
      return isActiveUser()
        && userProfile().role == 'admin';
    }

    function isStaff() {
      return isActiveUser()
        && userProfile().role == 'staff';
    }

    function isAuthorizedUser() {
      return isAdmin() || isStaff();
    }


    /* =================================
       USER PROFILES
    ================================= */

    match /users/{userId} {

      // Users can read their own profile.
      // Admin can read all user profiles.
      allow get: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow list: if isAdmin();

      // Only Admin can create or update staff profiles.
      allow create, update: if isAdmin()
        && request.resource.data.role == 'staff';

      allow delete: if isAdmin()
        && resource.data.role == 'staff';

    }


    /* =================================
       PRODUCTS / INVENTORY
    ================================= */

    match /products/{productId} {

      allow read: if isAuthorizedUser();

      allow create, update, delete: if isAuthorizedUser();

    }


    /* =================================
       SALES
    ================================= */

    match /sales/{saleId} {

      allow read: if isAuthorizedUser();

      allow create, update: if isAuthorizedUser();

      allow delete: if isAdmin();

    }


    /* =================================
       PRODUCT CODE COUNTERS
    ================================= */

    match /counters/{counterId} {

      allow read, write: if isAuthorizedUser();

    }


    /* =================================
       OPERATING EXPENSES
    ================================= */

    match /expenses/{expenseId} {

      allow read, create, update: if isAdmin();

      allow delete: if isAdmin();

    }


    /* =================================
       DEFAULT DENY
    ================================= */

    match /{document=**} {

      allow read, write: if false;

    }

  }
}
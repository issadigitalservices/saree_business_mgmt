rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function active(){return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;}
  function admin(){return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';}
  function staff(){return active() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';}
  function team(){return admin() || staff();}
  match /users/{uid}{allow read:if admin() || (signedIn() && request.auth.uid==uid);allow create,update,delete:if admin();}
  match /products/{id}{allow read,create,update:if team();allow delete:if admin();}
  match /sales/{id}{allow read,create,update:if team();allow delete:if admin();}
  match /expenses/{id}{allow create:if team();allow read,update,delete:if admin();}
  match /customers/{id}{allow read,create,update:if team();allow delete:if admin();}
  match /stockMovements/{id}{allow read,create:if team();allow update,delete:if admin();}
  match /settings/{id}{allow read,write:if admin();}
 }
}